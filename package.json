{
  "name": "capabilityecho",
  "version": "0.3.4",
  "description": "Code review for AI agent capability drift in pull requests.",
  "author": "Conal Hickey",
  "type": "module",
  "files": [
    "dist/",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "capabilityecho": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conalh/CapabilityEcho.git"
  },
  "bugs": {
    "url": "https://github.com/Conalh/CapabilityEcho/issues"
  },
  "homepage": "https://github.com/Conalh/CapabilityEcho#readme",
  "keywords": [
    "ai-agents",
    "github-action",
    "security",
    "static-analysis",
    "supply-chain"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle-action",
    "bundle-action": "ncc build src/action.ts -o dist/action-bundle --minify",
    "test": "node --test test/*.test.mjs",
    "benchmark": "tsc -p tsconfig.json && node benchmark/run-benchmark.mjs",
    "prepublishOnly": "npm run build && npm test && npm run benchmark"
  },
  "dependencies": {
    "agent-gov-core": "^1.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
