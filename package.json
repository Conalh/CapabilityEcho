{
  "name": "capabilityecho",
  "version": "0.1.0",
  "description": "Code review for AI agent capability drift in pull requests.",
  "type": "module",
  "bin": {
    "capabilityecho": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "action.yml",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conalh/CapabilityEcho.git"
  },
  "bugs": {
    "url": "https://github.com/Conalh/CapabilityEcho/issues"
  },
  "homepage": "https://github.com/Conalh/CapabilityEcho#readme",
  "keywords": [
    "capability-drift",
    "agent-governance",
    "ai-agents",
    "pull-request",
    "github-action",
    "static-analysis",
    "supply-chain"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle-action",
    "bundle-action": "ncc build src/action.ts -o dist/action-bundle --minify",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "agent-gov-core": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
